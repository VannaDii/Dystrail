### Ran Playwright code
```js
await (async page => {
  const results=[];
  for(const width of [1280,390]){
    await page.setViewportSize({width,height:900});
    const geometry=await page.evaluate(()=>[...document.querySelectorAll('.encounter-choice button')].map(button=>{
      const title=button.querySelector('.action-title').getBoundingClientRect();
      const detail=button.querySelector('.choice-effects').getBoundingClientRect();
      return {primaryLeft:title.left,subtitleLeft:detail.left,element:button.tagName};
    }));
    if(geometry.some(row=>Math.abs(row.primaryLeft-row.subtitleLeft)>1))throw Error(JSON.stringify(geometry));
    await page.screenshot({path:'output/playwright/hud-choice-'+width+'.png',fullPage:true});
    results.push({width,geometry});
  }
  return results;
})(page);
```
